generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  SALES_PURCHASING
  WAREHOUSE
}

enum SaleStatus {
  DRAFT
  CONFIRMED
  PAID
  CANCELLED
}

enum PurchaseStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT
}

model Company {
  id          String      @id @default(uuid()) @db.Uuid
  name        String
  taxId       String?     @unique
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  users       User[]
  customers   Customer[]
  products    Product[]
  warehouses  Warehouse[]
  sales       Sale[]
  purchases   Purchase[]
}

model User {
  id               String      @id @default(uuid()) @db.Uuid
  companyId        String      @db.Uuid
  email            String      @unique
  fullName         String
  passwordHash String
  role             UserRole    @default(SALES_PURCHASING)
  isActive         Boolean     @default(true)
  emailVerifiedAt  DateTime?
  passwordChangedAt DateTime   @default(now())
  lastLoginAt      DateTime?
  failedLoginCount Int         @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  company          Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sales            Sale[]      @relation("SaleCreatedBy")
  sessions         AuthSession[]
  loginAudits      LoginAudit[]
  @@index([companyId, isActive])
}

model AuthSession {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  refreshHash  String    @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model LoginAudit {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String?   @db.Uuid
  email       String
  success     Boolean
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime  @default(now())
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([email, createdAt])
}

model Customer {
  id          String      @id @default(uuid()) @db.Uuid
  companyId   String      @db.Uuid
  document    String?
  name        String
  email       String?
  phone       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sales       Sale[]
  @@index([companyId, name])
}

model Product {
  id          String           @id @default(uuid()) @db.Uuid
  companyId   String           @db.Uuid
  sku         String
  name        String
  unit        String           @default("UND")
  salePrice   Decimal          @db.Decimal(12, 2)
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stocks      InventoryStock[]
  movements   InventoryMovement[]
  saleItems   SaleItem[]
  purchaseItems PurchaseItem[]
  @@unique([companyId, sku])
}

model Warehouse {
  id          String           @id @default(uuid()) @db.Uuid
  companyId   String           @db.Uuid
  name        String
  address     String?
  isActive    Boolean          @default(true)
  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stocks      InventoryStock[]
  movements   InventoryMovement[]
  @@unique([companyId, name])
}

model InventoryStock {
  id          String      @id @default(uuid()) @db.Uuid
  productId   String      @db.Uuid
  warehouseId String      @db.Uuid
  quantity    Decimal     @default(0) @db.Decimal(14, 3)
  minimum     Decimal     @default(0) @db.Decimal(14, 3)
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse   Warehouse   @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  @@unique([productId, warehouseId])
}

model InventoryMovement {
  id          String       @id @default(uuid()) @db.Uuid
  productId   String       @db.Uuid
  warehouseId String       @db.Uuid
  type        MovementType
  quantity    Decimal      @db.Decimal(14, 3)
  reference   String?
  createdAt   DateTime     @default(now())
  product     Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse   Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  @@index([warehouseId, createdAt])
}

model Sale {
  id          String       @id @default(uuid()) @db.Uuid
  companyId   String       @db.Uuid
  customerId  String?      @db.Uuid
  createdById String       @db.Uuid
  number      String
  status      SaleStatus   @default(DRAFT)
  total       Decimal      @default(0) @db.Decimal(12, 2)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer    Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdBy   User         @relation("SaleCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  items       SaleItem[]
  @@unique([companyId, number])
  @@index([companyId, createdAt])
}

model SaleItem {
  id          String       @id @default(uuid()) @db.Uuid
  saleId      String       @db.Uuid
  productId   String       @db.Uuid
  quantity    Decimal      @db.Decimal(14, 3)
  unitPrice   Decimal      @db.Decimal(12, 2)
  subtotal    Decimal      @db.Decimal(12, 2)
  sale        Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product     Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
}

model Purchase {
  id          String         @id @default(uuid()) @db.Uuid
  companyId   String         @db.Uuid
  number      String
  supplierName String
  status      PurchaseStatus @default(DRAFT)
  total       Decimal        @default(0) @db.Decimal(12, 2)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  company     Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items       PurchaseItem[]
  @@unique([companyId, number])
}

model PurchaseItem {
  id          String       @id @default(uuid()) @db.Uuid
  purchaseId  String       @db.Uuid
  productId   String       @db.Uuid
  quantity    Decimal      @db.Decimal(14, 3)
  unitCost    Decimal      @db.Decimal(12, 2)
  subtotal    Decimal      @db.Decimal(12, 2)
  purchase    Purchase     @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product     Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
}

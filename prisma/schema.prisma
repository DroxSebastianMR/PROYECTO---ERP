generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  SALES_PURCHASING
  ACCOUNTANT
  WAREHOUSE
}

enum SaleStatus {
  DRAFT
  CONFIRMED
  PENDING_PAYMENT
  PARTIALLY_PAID
  PAID
  PREPARING
  DISPATCHED
  CANCELLED
}

enum SalePaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  YAPE_PLIN
  CREDIT
}

enum SaleDocumentType {
  RECEIPT
  INVOICE
}

enum PurchaseStatus {
  DRAFT
  ORDERED
  RECEIVED
  PARTIALLY_RECEIVED
  PENDING_PAYMENT
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  YAPE_PLIN
  CREDIT
}

enum PurchaseDocumentType {
  INVOICE
  RECEIPT
  CREDIT_NOTE
  OTHER
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT
  INITIAL
  PURCHASE_RECEIPT
  SALE_DISPATCH
  CUSTOMER_RETURN
  SUPPLIER_RETURN
  TRANSFER_OUT
  TRANSFER_IN
  POSITIVE_ADJUSTMENT
  NEGATIVE_ADJUSTMENT
  DAMAGED
  EXPIRED
}

enum WarehouseType {
  MAIN
  STORE
  DEPOT
  TEMPORARY
}

enum InventoryCountStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum TaxTreatment {
  TAXED
  EXONERATED
  UNAFFECTED
}

enum BarcodeFormat {
  CODE128
  EAN13
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum CashCountStatus {
  BALANCED
  SHORTAGE
  SURPLUS
}

model Company {
  id          String      @id @default(uuid()) @db.Uuid
  name        String
  taxId       String?     @unique
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  users       User[]
  customers   Customer[]
  products    Product[]
  productCategories ProductCategory[]
  productSubcategories ProductSubcategory[]
  productBrands ProductBrand[]
  measurementUnits MeasurementUnit[]
  productPresentations ProductPresentation[]
  productBarcodes ProductBarcode[]
  inventoryTransfers InventoryTransfer[]
  inventoryCounts InventoryCount[]
  warehouses  Warehouse[]
  sales       Sale[]
  purchases   Purchase[]
  suppliers   Supplier[]
  cashRegisters CashRegister[]
  cashSessions CashSession[]
  cashMovements CashMovement[]
  accessRoles AccessRole[]
}

model User {
  id               String      @id @default(uuid()) @db.Uuid
  companyId        String      @db.Uuid
  email            String      @unique
  fullName         String
  passwordHash String
  role             UserRole    @default(SALES_PURCHASING)
  permissions      String[]    @default([])
  isActive         Boolean     @default(true)
  emailVerifiedAt  DateTime?
  passwordChangedAt DateTime   @default(now())
  lastLoginAt      DateTime?
  failedLoginCount Int         @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  company          Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sales            Sale[]      @relation("SaleCreatedBy")
  sessions         AuthSession[]
  loginAudits      LoginAudit[]
  inventoryMovements InventoryMovement[]
  notifications     Notification[]
  openedCashSessions CashSession[] @relation("CashSessionOpenedBy")
  closedCashSessions CashSession[] @relation("CashSessionClosedBy")
  cashCounts        CashCount[]
  cashMovements     CashMovement[]
  directPermissions UserPermission[]
  @@index([companyId, isActive])
}

model PermissionDefinition {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  module      String
  resource    String
  action      String
  description String
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  rolePermissions RolePermission[]
  userPermissions UserPermission[]
  accessRolePermissions AccessRolePermission[]
}

model RolePermission {
  role         UserRole
  permissionId String           @db.Uuid
  permission   PermissionDefinition @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime         @default(now())
  @@id([role, permissionId])
  @@index([permissionId])
}

model UserPermission {
  userId       String           @db.Uuid
  permissionId String           @db.Uuid
  createdAt    DateTime         @default(now())
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   PermissionDefinition @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([userId, permissionId])
  @@index([permissionId])
}

model CashRegister {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid
  name      String
  code      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sessions  CashSession[]
  @@unique([companyId, name])
  @@unique([companyId, code])
}

model CashSession {
  id              String            @id @default(uuid()) @db.Uuid
  companyId       String            @db.Uuid
  cashRegisterId  String            @db.Uuid
  openedById      String            @db.Uuid
  openedAt        DateTime          @default(now())
  openingAmount   Decimal           @db.Decimal(12, 2)
  openingNotes    String?
  status          CashSessionStatus @default(OPEN)
  closedById      String?           @db.Uuid
  closedAt        DateTime?
  closingAmount   Decimal?          @db.Decimal(12, 2)
  expectedAmount  Decimal?          @db.Decimal(12, 2)
  countedAmount   Decimal?          @db.Decimal(12, 2)
  difference      Decimal?          @db.Decimal(12, 2)
  closingNotes    String?
  closingIp       String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  company         Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  cashRegister    CashRegister      @relation(fields: [cashRegisterId], references: [id], onDelete: Restrict)
  openedBy        User              @relation("CashSessionOpenedBy", fields: [openedById], references: [id], onDelete: Restrict)
  closedBy        User?             @relation("CashSessionClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  counts          CashCount[]
  movements       CashMovement[]
  @@index([companyId, status])
  @@index([cashRegisterId, status])
  @@index([openedById, status])
}

model CashMovement {
  id            String      @id @default(uuid()) @db.Uuid
  companyId     String      @db.Uuid
  cashSessionId String      @db.Uuid
  userId        String      @db.Uuid
  type          String
  description   String
  amount        Decimal     @db.Decimal(12, 2)
  paymentMethod PaymentMethod @default(CASH)
  createdAt     DateTime    @default(now())
  company       Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  cashSession   CashSession @relation(fields: [cashSessionId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([cashSessionId, createdAt])
  @@index([companyId, createdAt])
}

model CashCount {
  id              String          @id @default(uuid()) @db.Uuid
  cashSessionId   String          @db.Uuid
  userId          String          @db.Uuid
  expectedAmount  Decimal         @db.Decimal(12, 2)
  countedAmount   Decimal         @db.Decimal(12, 2)
  difference      Decimal         @db.Decimal(12, 2)
  status          CashCountStatus
  explanation     String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  cashSession     CashSession     @relation(fields: [cashSessionId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  details         CashCountDetail[]
  @@index([cashSessionId, createdAt])
}

model CashCountDetail {
  id          String    @id @default(uuid()) @db.Uuid
  cashCountId String    @db.Uuid
  denomination Decimal  @db.Decimal(8, 2)
  quantity    Int
  subtotal    Decimal  @db.Decimal(12, 2)
  cashCount   CashCount @relation(fields: [cashCountId], references: [id], onDelete: Cascade)
  @@unique([cashCountId, denomination])
}

enum NotificationType {
  INVENTORY
  SALE
  PURCHASE
  SYSTEM
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType @default(SYSTEM)
  title     String
  message   String
  actionUrl String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, isRead, createdAt])
}

model AuthSession {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  refreshHash  String    @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model LoginAudit {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String?   @db.Uuid
  email       String
  success     Boolean
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime  @default(now())
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([email, createdAt])
}

model Customer {
  id          String      @id @default(uuid()) @db.Uuid
  companyId   String      @db.Uuid
  code        String
  customerType String     @default("PERSONA_NATURAL")
  documentType String     @default("DNI")
  document    String?
  name        String
  firstName   String?
  lastName    String?
  birthDate   DateTime?
  gender      String?
  civilStatus String?
  companyName String?
  tradeName   String?
  legalRepresentative String?
  representativeRole String?
  email       String?
  phone       String?
  mobilePhone String?
  companyPhone String?
  companyEmail String?
  address     String?
  ubigeo      String?
  category    String      @default("REGULAR")
  status      String      @default("ACTIVO")
  notes       String?
  creditLimit Decimal     @default(0) @db.Decimal(12, 2)
  creditDays  Int         @default(0)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sales       Sale[]
  @@index([companyId, name])
  @@unique([companyId, code])
  @@unique([companyId, document])
}

model Product {
  id          String           @id @default(uuid()) @db.Uuid
  companyId   String           @db.Uuid
  sku         String
  barcode     String?
  name        String
  categoryId  String?          @db.Uuid
  subcategoryId String?        @db.Uuid
  brandId     String?          @db.Uuid
  unit        String           @default("UND")
  presentation String?
  purchasePrice Decimal?       @db.Decimal(12, 2)
  salePrice   Decimal          @db.Decimal(12, 2)
  wholesalePrice Decimal?      @db.Decimal(12, 2)
  wholesaleMinQuantity Decimal? @db.Decimal(14, 3)
  sellRetail Boolean           @default(true)
  sellWholesale Boolean        @default(true)
  taxTreatment TaxTreatment    @default(TAXED)
  imageUrl    String?
  description String?
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category    ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subcategory ProductSubcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  brand       ProductBrand?    @relation(fields: [brandId], references: [id], onDelete: SetNull)
  presentations ProductPresentation[]
  barcodes     ProductBarcode[]
  stocks      InventoryStock[]
  movements   InventoryMovement[]
  saleItems   SaleItem[]
  purchaseItems PurchaseItem[]
  batches      InventoryBatch[]
  transferItems InventoryTransferItem[]
  countLines   InventoryCountLine[]
  @@unique([companyId, sku])
  @@unique([companyId, barcode])
  @@index([companyId, name])
  @@index([companyId, isActive])
}

model ProductBarcode {
  id        String        @id @default(uuid()) @db.Uuid
  companyId String        @db.Uuid
  productId String        @db.Uuid
  code      String
  format    BarcodeFormat @default(CODE128)
  isPrimary Boolean       @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@unique([companyId, code])
  @@unique([productId, code])
  @@index([companyId, productId])
}

model ProductCategory {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @db.Uuid
  code        String?
  name        String
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products    Product[]
  subcategories ProductSubcategory[]
  @@unique([companyId, name])
  @@unique([companyId, code])
}

model ProductSubcategory {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @db.Uuid
  categoryId  String   @db.Uuid
  name        String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category    ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products    Product[]
  @@unique([categoryId, name])
  @@index([companyId, categoryId])
}

model ProductBrand {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @db.Uuid
  name        String
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products    Product[]
  @@unique([companyId, name])
}

model MeasurementUnit {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid
  code      String
  abbreviation String?
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  @@unique([companyId, code])
  @@unique([companyId, name])
  @@index([companyId, isActive])
}

model ProductPresentation {
  id             String    @id @default(uuid()) @db.Uuid
  companyId      String    @db.Uuid
  productId      String    @db.Uuid
  name           String
  unit           String
  unitsPerBase   Decimal   @default(1) @db.Decimal(14, 3)
  barcode        String?
  salePrice      Decimal?  @db.Decimal(12, 2)
  wholesalePrice Decimal?  @db.Decimal(12, 2)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product        Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@unique([productId, name])
  @@unique([companyId, barcode])
}

model Warehouse {
  id          String           @id @default(uuid()) @db.Uuid
  companyId   String           @db.Uuid
  name        String
  code        String?
  type        WarehouseType @default(MAIN)
  isPrimary   Boolean       @default(false)
  address     String?
  isActive    Boolean          @default(true)
  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stocks      InventoryStock[]
  movements   InventoryMovement[]
  batches     InventoryBatch[]
  countLines  InventoryCountLine[]
  counts      InventoryCount[]
  transferOrigins InventoryTransfer[] @relation("TransferOrigin")
  transferDestinations InventoryTransfer[] @relation("TransferDestination")
  purchaseReceipts PurchaseReceipt[]
  purchases Purchase[]
  sales Sale[]
  saleDispatches SaleDispatch[]
  saleReturns SaleReturn[]
  @@unique([companyId, name])
  @@unique([companyId, code])
  @@index([companyId, isActive, isPrimary])
}

model InventoryStock {
  id          String      @id @default(uuid()) @db.Uuid
  productId   String      @db.Uuid
  warehouseId String      @db.Uuid
  quantity    Decimal     @default(0) @db.Decimal(14, 3)
  reserved    Decimal     @default(0) @db.Decimal(14, 3)
  minimum     Decimal     @default(0) @db.Decimal(14, 3)
  maximum     Decimal?    @db.Decimal(14, 3)
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse   Warehouse   @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  @@unique([productId, warehouseId])
  @@index([warehouseId, productId])
}

model InventoryMovement {
  id          String       @id @default(uuid()) @db.Uuid
  productId   String       @db.Uuid
  warehouseId String       @db.Uuid
  type        MovementType
  quantity    Decimal      @db.Decimal(14, 3)
  quantityIn  Decimal      @default(0) @db.Decimal(14, 3)
  quantityOut Decimal      @default(0) @db.Decimal(14, 3)
  previousStock Decimal?   @db.Decimal(14, 3)
  resultingStock Decimal?  @db.Decimal(14, 3)
  documentRef String?
  reason      String?
  createdById String?      @db.Uuid
  batchId     String?      @db.Uuid
  reference   String?
  createdAt   DateTime     @default(now())
  product     Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse   Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  createdBy   User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  batch       InventoryBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  @@index([warehouseId, createdAt])
}

model InventoryBatch {
  id             String   @id @default(uuid()) @db.Uuid
  productId      String   @db.Uuid
  warehouseId    String   @db.Uuid
  lotNumber      String
  manufacturedAt DateTime?
  expiresAt      DateTime?
  quantity       Decimal  @default(0) @db.Decimal(14, 3)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse      Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  movements      InventoryMovement[]
  @@unique([productId, warehouseId, lotNumber])
  @@index([warehouseId, expiresAt])
}

model InventoryTransfer {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String   @db.Uuid
  originWarehouseId String @db.Uuid
  destinationWarehouseId String @db.Uuid
  status          String   @default("COMPLETED")
  reference       String?  @unique
  notes           String?
  createdById     String?  @db.Uuid
  createdAt       DateTime @default(now())
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  originWarehouse Warehouse @relation("TransferOrigin", fields: [originWarehouseId], references: [id], onDelete: Restrict)
  destinationWarehouse Warehouse @relation("TransferDestination", fields: [destinationWarehouseId], references: [id], onDelete: Restrict)
  items           InventoryTransferItem[]
}

model InventoryTransferItem {
  id          String @id @default(uuid()) @db.Uuid
  transferId  String @db.Uuid
  productId   String @db.Uuid
  quantity    Decimal @db.Decimal(14, 3)
  transfer    InventoryTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product     Product @relation(fields: [productId], references: [id], onDelete: Restrict)
}

model InventoryCount {
  id          String @id @default(uuid()) @db.Uuid
  companyId   String @db.Uuid
  warehouseId String @db.Uuid
  status      InventoryCountStatus @default(DRAFT)
  notes       String?
  createdById String? @db.Uuid
  approvedById String? @db.Uuid
  createdAt   DateTime @default(now())
  approvedAt  DateTime?
  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  lines       InventoryCountLine[]
}

model InventoryCountLine {
  id          String @id @default(uuid()) @db.Uuid
  countId     String @db.Uuid
  productId   String @db.Uuid
  warehouseId String @db.Uuid
  systemQuantity Decimal @db.Decimal(14, 3)
  countedQuantity Decimal @db.Decimal(14, 3)
  difference  Decimal @db.Decimal(14, 3)
  reason      String?
  count       InventoryCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  product     Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  @@unique([countId, productId])
}

model Sale {
  id          String       @id @default(uuid()) @db.Uuid
  companyId   String       @db.Uuid
  customerId  String?      @db.Uuid
  createdById String       @db.Uuid
  number      String
  idempotencyKey String?
  status      SaleStatus   @default(DRAFT)
  warehouseId String?      @db.Uuid
  paymentMethod SalePaymentMethod @default(CASH)
  documentType SaleDocumentType @default(RECEIPT)
  currency    String       @default("PEN")
  subtotal    Decimal      @default(0) @db.Decimal(12, 2)
  taxAmount   Decimal      @default(0) @db.Decimal(12, 2)
  discountAmount Decimal   @default(0) @db.Decimal(12, 2)
  total       Decimal      @default(0) @db.Decimal(12, 2)
  dueAt       DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer    Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  warehouse   Warehouse?   @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  createdBy   User         @relation("SaleCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  items       SaleItem[]
  document    SaleDocument?
  payments    SalePayment[]
  dispatches  SaleDispatch[]
  returns     SaleReturn[]
  @@unique([companyId, number])
  @@unique([companyId, idempotencyKey])
  @@index([companyId, createdAt])
  @@index([companyId, status, createdAt])
}

model SaleItem {
  id          String       @id @default(uuid()) @db.Uuid
  saleId      String       @db.Uuid
  productId   String       @db.Uuid
  quantity    Decimal      @db.Decimal(14, 3)
  unitPrice   Decimal      @db.Decimal(12, 2)
  discount    Decimal      @default(0) @db.Decimal(12, 2)
  taxRate     Decimal      @default(18) @db.Decimal(5, 2)
  subtotal    Decimal      @db.Decimal(12, 2)
  sale        Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product     Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  returnLines SaleReturnLine[]
}

model SaleDocument {
  id          String           @id @default(uuid()) @db.Uuid
  saleId      String           @unique @db.Uuid
  type        SaleDocumentType
  series      String
  number      String
  issuedAt    DateTime         @default(now())
  sale        Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  @@unique([type, series, number])
}

model SalePayment {
  id          String            @id @default(uuid()) @db.Uuid
  saleId      String            @db.Uuid
  amount      Decimal           @db.Decimal(12, 2)
  method      SalePaymentMethod
  paidAt      DateTime          @default(now())
  reference   String?
  sale        Sale              @relation(fields: [saleId], references: [id], onDelete: Cascade)
  @@index([saleId, paidAt])
}

model SaleDispatch {
  id          String   @id @default(uuid()) @db.Uuid
  saleId      String   @db.Uuid
  warehouseId String   @db.Uuid
  dispatchedAt DateTime @default(now())
  dispatchedById String? @db.Uuid
  notes       String?
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
}

model SaleReturn {
  id          String   @id @default(uuid()) @db.Uuid
  saleId      String   @db.Uuid
  warehouseId String   @db.Uuid
  reason      String
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  lines       SaleReturnLine[]
}

model SaleReturnLine {
  id          String     @id @default(uuid()) @db.Uuid
  returnId    String     @db.Uuid
  saleItemId  String     @db.Uuid
  quantity    Decimal    @db.Decimal(14, 3)
  saleReturn  SaleReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItem    SaleItem   @relation(fields: [saleItemId], references: [id], onDelete: Restrict)
}

model Purchase {
  id          String         @id @default(uuid()) @db.Uuid
  companyId   String         @db.Uuid
  number      String
  supplierId  String?        @db.Uuid
  supplierName String
  status      PurchaseStatus @default(DRAFT)
  expectedDeliveryAt DateTime?
  purchasedAt  DateTime?
  warehouseEntryAt DateTime?
  notes       String?
  warehouseId String?        @db.Uuid
  paymentMethod PaymentMethod @default(CREDIT)
  currency    String         @default("PEN")
  subtotal    Decimal        @default(0) @db.Decimal(12, 2)
  taxAmount   Decimal        @default(0) @db.Decimal(12, 2)
  discountAmount Decimal     @default(0) @db.Decimal(12, 2)
  total       Decimal        @default(0) @db.Decimal(12, 2)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  company     Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier    Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  warehouse   Warehouse?     @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  items       PurchaseItem[]
  receipts    PurchaseReceipt[]
  document    PurchaseDocument?
  payable     AccountsPayable?
  @@unique([companyId, number])
  @@index([companyId, createdAt])
}

model PurchaseItem {
  id          String       @id @default(uuid()) @db.Uuid
  purchaseId  String       @db.Uuid
  productId   String       @db.Uuid
  presentationName String?
  unit        String?
  quantity    Decimal      @db.Decimal(14, 3)
  receivedQuantity Decimal @default(0) @db.Decimal(14, 3)
  unitCost    Decimal      @db.Decimal(12, 2)
  discount    Decimal      @default(0) @db.Decimal(12, 2)
  taxRate     Decimal      @default(18) @db.Decimal(5, 2)
  subtotal    Decimal      @db.Decimal(12, 2)
  purchase    Purchase     @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product     Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  receiptLines PurchaseReceiptLine[]
  @@index([purchaseId])
}

model AccessRole {
  id          String       @id @default(uuid()) @db.Uuid
  companyId   String       @db.Uuid
  code        String
  name        String
  description String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  permissions AccessRolePermission[]
  @@unique([companyId, code])
  @@unique([companyId, name])
  @@index([companyId, isActive])
}

model AccessRolePermission {
  accessRoleId String       @db.Uuid
  permissionId String       @db.Uuid
  createdAt    DateTime     @default(now())
  accessRole   AccessRole   @relation(fields: [accessRoleId], references: [id], onDelete: Cascade)
  permission   PermissionDefinition @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([accessRoleId, permissionId])
  @@index([permissionId])
}

model Supplier {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @db.Uuid
  code          String
  ruc           String?
  businessName  String
  tradeName     String?
  address       String?
  phone         String?
  email         String?
  contactName   String?
  paymentTermsDays Int @default(30)
  isActive      Boolean @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  company       Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchases     Purchase[]
  @@unique([companyId, code])
  @@unique([companyId, ruc])
  @@index([companyId, businessName])
}

model PurchaseReceipt {
  id          String @id @default(uuid()) @db.Uuid
  purchaseId  String @db.Uuid
  warehouseId String @db.Uuid
  receivedAt  DateTime @default(now())
  notes       String?
  receivedById String? @db.Uuid
  purchase    Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  lines       PurchaseReceiptLine[]
}

model PurchaseReceiptLine {
  id          String @id @default(uuid()) @db.Uuid
  receiptId   String @db.Uuid
  purchaseItemId String @db.Uuid
  receivedQuantity Decimal @db.Decimal(14, 3)
  damagedQuantity Decimal @default(0) @db.Decimal(14, 3)
  lotNumber   String?
  expiresAt   DateTime?
  receipt     PurchaseReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  purchaseItem PurchaseItem @relation(fields: [purchaseItemId], references: [id], onDelete: Restrict)
}

model PurchaseDocument {
  id          String @id @default(uuid()) @db.Uuid
  purchaseId  String @unique @db.Uuid
  type        PurchaseDocumentType
  series      String?
  number      String
  issuedAt    DateTime
  dueAt       DateTime?
  fileUrl     String?
  xmlUrl      String?
  purchase    Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  @@unique([type, series, number])
}

model AccountsPayable {
  id          String @id @default(uuid()) @db.Uuid
  purchaseId  String @unique @db.Uuid
  originalAmount Decimal @db.Decimal(12, 2)
  paidAmount  Decimal @default(0) @db.Decimal(12, 2)
  dueAt       DateTime?
  status      String @default("PENDING")
  purchase    Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  payments    SupplierPayment[]
}

model SupplierPayment {
  id          String @id @default(uuid()) @db.Uuid
  payableId   String @db.Uuid
  amount      Decimal @db.Decimal(12, 2)
  method      PaymentMethod
  paidAt      DateTime @default(now())
  reference   String?
  payable     AccountsPayable @relation(fields: [payableId], references: [id], onDelete: Cascade)
}
